# Copiar a .env para desarrollo local.
# Modo del equipo (doc 29): la app habla SOLO con la API Java (api-gateway :8080 → agro-service :8081 → calculos :8001).
VITE_CALCULOS_URL=
VITE_USE_MOCK=false
VITE_API_URL=http://localhost:8080
# En el celular usa la IP de la PC, p. ej. http://192.168.18.79:8080
#
# Alternativas (solo para pruebas):
#   directo al servicio de cálculos:  VITE_CALCULOS_URL=http://localhost:8001
#   datos de ejemplo (banner amarillo): VITE_CALCULOS_URL=  y  VITE_USE_MOCK=true
