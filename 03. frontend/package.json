{
  "name": "allpashift",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run test:datos && vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b",
    "android": "npm run build:mobile && cap sync android && cap open android",
    "android:sync": "npm run build:mobile && cap sync android",
    "android:run": "npm run build:mobile && cap sync android && cap run android",
    "test:datos": "node scripts/verificar-datos.mjs",
    "build:mobile": "npm run test:datos && vue-tsc -b && vite build --mode mobile",
    "ios:sync": "npm run build:mobile && cap sync ios",
    "movil:recursos": "capacitor-assets generate --iconBackgroundColor '#0f2a1f' --iconBackgroundColorDark '#0f2a1f' --splashBackgroundColor '#0f2a1f' --splashBackgroundColorDark '#0f2a1f'"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.3",
    "@capacitor/app": "^6.0.3",
    "@capacitor/core": "^6.2.3",
    "@capacitor/geolocation": "^6.1.1",
    "@capacitor/ios": "^6.2.3",
    "@capacitor/splash-screen": "^6.0.4",
    "@capacitor/status-bar": "^6.0.3",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "axios": "^1.21.1",
    "chart.js": "^4.6.1",
    "leaflet": "^1.9.4",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.45",
    "vue-chartjs": "^5.3.4",
    "vue-i18n": "^11.4.19",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.2.3",
    "@tailwindcss/vite": "^4.3.5",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/tsconfig": "^0.9.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vue-tsc": "^3.3.14"
  }
}
