# Copia este archivo como ".env" (el .gitignore del repo ya lo ignora) y completa los valores.
# NUNCA subas el .env ni compartas el token por chat/captura.

# --- NASA Earthdata (https://urs.earthdata.nasa.gov) ---
# Perfil -> "Generate Token". Sirve para descargar SMAP, GPM IMERG, MODIS, ECOSTRESS.
EARTHDATA_TOKEN=
# Solo para AppEEARS (login con usuario y clave de Earthdata). Opcional.
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# --- Servicio ---
PORT=8000
