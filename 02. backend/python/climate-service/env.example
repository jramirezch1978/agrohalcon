# Copia este archivo como ".env" (el .gitignore del repo ya lo ignora) y completa los valores.
# NUNCA subas el .env ni compartas el token por chat/captura.

# --- NASA Earthdata (https://urs.earthdata.nasa.gov) ---
# Perfil -> "Generate Token". Sirve para descargar SMAP, GPM IMERG, MODIS, ECOSTRESS.
EARTHDATA_TOKEN=
# Solo para AppEEARS (login con usuario y clave de Earthdata). Opcional.
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# --- Groq: asistente de IA (modelo de código abierto, licencia Apache 2.0) ---
# La clave vive SOLO aquí (tu .env) y en deploy/vps/.env del servidor. El repositorio es público: nunca la pegues en el código,
# en un chat ni en una captura. Sin clave el asistente responde con plantillas (sin IA).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Límites para proteger la cuota (opcionales): por cliente y por minuto, en total por minuto y por día
# GROQ_MAX_POR_MINUTO_CLIENTE=8
# GROQ_MAX_POR_MINUTO=40
# GROQ_MAX_DIARIO=1500

# --- Servicio ---
PORT=8000
